    "postinstall": "node -e \"const fs=require('fs');fs.cpSync('node_modules/monaco-editor/min/vs','public/vs',{recursive:true,force:true});const p='public/vs/loader.js';fs.writeFileSync(p,fs.readFileSync(p,'utf8').replace(/\\n\\/\\/# sourceMappingURL=.*/,''));const q='node_modules/pdfjs-dist/';fs.rmSync('public/pdfjs',{recursive:true,force:true});for(const s of ['legacy/build/pdf.worker.min.mjs','cmaps','standard_fonts','wasm','iccs'])fs.cpSync(q+s,'public/pdfjs/'+s.replace('legacy/build/',''),{recursive:true})\"",
    "server:sign": "tauri signer sign"
  },
